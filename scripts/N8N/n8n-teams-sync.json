    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.erreurs.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "id": "b1f3c2a0-1111-4c1a-9a01-000000000002"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -224,
        176
      ],
      "name": "Erreurs ?"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst ts = new Date(r.timestamp).toLocaleString('fr-CH', { timeZone: 'Europe/Zurich' });\nconst sujet = `⚠️ [RAG TEAMS] Erreur de synchronisation : ${new Date().toISOString().split('T')[0]}`;\nlet corps = `RAPPORT DE SYNCHRONISATION TEAMS : ERREUR\\n`;\ncorps += `Horodatage : ${ts}\\n`;\ncorps += `Brouillons produits : ${r.brouillons_count}\\n\\n`;\ncorps += `Erreurs :\\n`;\nfor (const e of r.erreurs) corps += `  • ${e}\\n`;\ncorps += `\\nDétail sur VM-RAG-LAB :\\n`;\ncorps += `  docker logs rag-api 2>&1 | grep TEAMS | tail -20\\n`;\ncorps += `  docker exec -e PYTHONPATH=/app -w /app rag-api python3 /rag-pipeline/test_teams_graph.py\\n`;\nreturn [{ json: { sujet, corps } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        160
      ],
      "name": "Formater alerte"
    },
    {
      "parameters": {
        "fromEmail": "<EMAIL_EXPEDITEUR>",
        "toEmail": "<EMAIL_ADMIN>",
        "subject": "={{ $json.sujet }}",
        "emailFormat": "text",
        "text": "={{ $json.corps }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        224,
        160
      ],
      "name": "Email alerte administrateur",
      "credentials": {
        "smtp": {
          "id": "<SMTP_CREDENTIAL_ID>",
          "name": "SMTP account"
        }
      }
    }
  ],
