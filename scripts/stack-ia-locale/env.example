# =========================================================
# Stack RAG locale : fichier de configuration
# Emplacement : /root/rag-stack/.env
# Ne jamais committer ce fichier dans Git.
#
# IMPORTANT : docker-compose.yml référence ces variables avec ${VAR}.
# Une variable absente ici est transmise au conteneur avec une valeur VIDE,
# et non avec la valeur par défaut du code Python. Toute variable listée
# dans le bloc environment du Compose doit donc être définie ici.
# =========================================================

# ---------------------------------------------------------
# Serveur de modèles (§2) : Ollama OU vLLM
# Un seul des deux blocs doit être actif (sans # en début de ligne).
#   Ollama : simple à installer, une question à la fois dans la
#            configuration du guide. Un à deux utilisateurs simultanés.
#   vLLM   : traite plusieurs questions en même temps. Plusieurs
#            utilisateurs simultanés. Serveur Linux ou WSL2 (§2.4).
# <IP-SERVEUR-MODELES> : adresse de la machine qui porte la carte
# graphique, jamais localhost (dans un conteneur, localhost désigne
# le conteneur lui-même).
# ---------------------------------------------------------

# Bloc A : Ollama (port 11434)
LLM_API=ollama
EMBED_API=ollama
LLM_BASE_URL=http://<IP-SERVEUR-MODELES>:11434
EMBED_BASE_URL=http://<IP-SERVEUR-MODELES>:11434
JUDGE_BASE_URL=
LLM_MODEL=qwen3:14b
JUDGE_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text
VLLM_API_KEY=

# Bloc B : vLLM (port 8000 pour la génération, 8001 pour l'embedding).
# Le juge est le modèle principal : vLLM réserve la mémoire de la carte
# au démarrage, il n'y a pas de place pour un troisième modèle (§2.4).
# VLLM_API_KEY : la même clé que dans /etc/vllm/vllm.env sur le serveur.
# LLM_API=openai
# EMBED_API=openai
# LLM_BASE_URL=http://<IP-SERVEUR-MODELES>:8000
# EMBED_BASE_URL=http://<IP-SERVEUR-MODELES>:8001
# JUDGE_BASE_URL=
# LLM_MODEL=qwen3:14b
# JUDGE_MODEL=qwen3:14b
# EMBED_MODEL=nomic-embed-text
# VLLM_API_KEY=<clé-vllm>

# Avec Ollama seulement : durée de rétention du juge en mémoire après
# chaque appel. Format : "5m", "2h", "-1" (indéfiniment). Sans effet avec vLLM.
JUDGE_KEEP_ALIVE=2h

# EMBED_MODEL doit être IDENTIQUE au modèle ayant servi à indexer.
# Vérification (QDRANT_API_KEY : voir plus bas) :
#   curl -s http://localhost:6333/collections/documents/points/scroll \
#     -H "api-key: <QDRANT_API_KEY>" -H "Content-Type: application/json" \
#     -d '{"limit":1,"with_payload":true}' | grep -o '"embed_model":"[^"]*"'
# Passer d'Ollama à vLLM ne change pas les vecteurs de nomic-embed-text
# (mesuré, §2.5). Un AUTRE modèle d'embedding impose de réindexer
# avec indexer.py --reset.

# ---------------------------------------------------------
# Qdrant
# ---------------------------------------------------------
QDRANT_HOST=http://qdrant:6333
QDRANT_COLLECTION=documents
# Clé d'API obligatoire (section 15) : openssl rand -hex 32
# Les commandes curl vers Qdrant doivent envoyer l'en-tête « api-key: <clé> ».
QDRANT_API_KEY=changeme-qdrant-api-key

# Clé des empreintes HMAC des questions dans le journal (§16.6) : openssl rand -hex 32
LOG_HMAC_KEY=changeme-log-hmac-key
# Cas de cloisonnement rejoués après chaque synchronisation (§16.4) ; fichier absent : contrôle désactivé
CAS_CLOISONNEMENT=/rag-pipeline/cas_cloisonnement.json

# Seconde collection : documentation technique.
# DOCUMENTATION_PATHS : dossiers racine du partage (séparés par des virgules)
# dont le contenu est routé vers DOCUMENTATION_COLLECTION. À remplacer par
# le nom de votre propre dossier de documentation (ici l'exemple du lab).
DOCUMENTATION_COLLECTION=documentation
DOCUMENTATION_PATHS=DOIT4EVERYONE

# ---------------------------------------------------------
# Comportement du retriever
# TOP_K              : nombre de chunks récupérés par requête
# CONTEXT_THRESHOLD  : score au-delà duquel tous les chunks du document
#                      le mieux classé sont chargés (extension de contexte)
# MAX_CONTEXT_CHUNKS : plafond de chunks après extension
# ---------------------------------------------------------
TOP_K=20
# Obsolète depuis v2.17.2 : remplacé par CANDIDATS. Conservé sans effet.
CONTEXT_THRESHOLD=0.01
MAX_CONTEXT_CHUNKS=14
# Plafond d'extraits envoyés au modèle quand aucun document n'est en tête.
# Diversité des sources (§8.9) : les valeurs par défaut, validées en lab sur CPU,
# s'appliquent si ces lignes restent commentées.
# CANDIDATS=30                 # candidats retenus par la recherche avant sélection
# PRINCIPAL_MAX=9              # extraits du document principal
# CONTEXT_OTHER_DOCS=6         # documents complémentaires
# EXTRAITS_PAR_COMPLEMENT=4    # extraits consécutifs par document complémentaire (§10.6)

# ---------------------------------------------------------
# Identité affichée dans le prompt système
# ---------------------------------------------------------
ORG_NAME=<Nom organisation>

# ---------------------------------------------------------
# Authentification API
# À remplacer par des valeurs générées : openssl rand -hex 32
# API_TOKEN   : appels /query et /v1/chat/completions
# ADMIN_TOKEN : appels /admin/sync, distinct du précédent
# ---------------------------------------------------------
API_TOKEN=changeme-api-token
ADMIN_TOKEN=changeme-admin-token

# ---------------------------------------------------------
# Journalisation nLPD et rapports de synchronisation
# REPORT_DIR doit être un volume monté en écriture (voir docker-compose.yml).
# ---------------------------------------------------------
LOG_FILE=/var/log/rag/rag-queries.jsonl
REPORT_DIR=/var/log/rag

# ---------------------------------------------------------
# Annuaire Active Directory (résolution des groupes, auth.py)
# LDAP_HOST en FQDN : requis pour la validation du certificat LDAPS.
# LDAP_CA_CERT : si le fichier est absent, le code retombe sur
# CERT_NONE avec un avertissement dans les logs.
# ---------------------------------------------------------
LDAP_HOST=<NOM-DC>.votre-domaine.ch
LDAP_PORT=636
LDAP_USE_TLS=true
LDAP_BASE_DN=DC=votre-domaine,DC=ch
LDAP_BIND_DN=CN=svc-rag,OU=COMPTES-SERVICE,DC=votre-domaine,DC=ch
LDAP_BIND_PWD=<mot-de-passe-svc-rag>
LDAP_DOMAIN=VOTRE-DOMAINE
LDAP_CA_CERT=/etc/ssl/certs/ad-chain.pem
GROUPS_CACHE_TTL=300

# ─────────────────────────────────────────
# Extension Entra ID (Partie 3, désactivée par défaut)
# ─────────────────────────────────────────
# Ajoute aux groupes AD les identifiants Entra de l'utilisateur (Graph API),
# nécessaires au cloisonnement des documents SharePoint.
# App Registration dédiée, permissions application : User.Read.All et
# GroupMember.Read.All. Authentification par certificat, sans secret client.
ENTRA_ENABLED=false
ENTRA_TENANT_ID=<ID-ANNUAIRE>
ENTRA_CLIENT_ID=<ID-APPLICATION>
ENTRA_CERT_PATH=/etc/rag-certs/rag-identity.crt
ENTRA_KEY_PATH=/etc/rag-certs/rag-identity.key
# Empreinte SHA-1 affichée dans Entra (Certificats et secrets)
ENTRA_CERT_THUMBPRINT=<EMPREINTE-CERTIFICAT>

# ─────────────────────────────────────────
# Synthèse des réunions Teams (Partie 3)
# ─────────────────────────────────────────
# Application RAG-Teams-Reader : permission OnlineMeetingTranscript.Read.All
# et stratégie d'accès applicatif Teams attribuée au groupe d'adhésion.
# Le groupe (sécurité à extension messagerie) définit à la fois les droits
# de l'application et les organisateurs dont les réunions sont traitées.
TEAMS_CLIENT_ID=<ID-APPLICATION-TEAMS>
TEAMS_CERT_PATH=/etc/rag-certs/rag-teams.crt
TEAMS_KEY_PATH=/etc/rag-certs/rag-teams.key
TEAMS_CERT_THUMBPRINT=<EMPREINTE-CERTIFICAT-TEAMS>
TEAMS_GROUP_ID=<ID-OBJET-GROUPE-ADHESION>
# Fenêtre de recherche des transcriptions, en heures
TEAMS_LOOKBACK_HOURS=48
# Nombre maximal de synthèses par passage (chaque synthèse prend plusieurs minutes sur CPU)
TEAMS_MAX_PAR_SYNC=3
# Identifiants des transcriptions déjà traitées (jamais leur contenu)
TEAMS_STATE_FILE=/var/log/rag/teams_state.json

# ─────────────────────────────────────────
# Indexation SharePoint Online (Partie 3, §13)
# ─────────────────────────────────────────
# Application RAG-SharePoint-Indexer : Sites.Selected (Graph et SharePoint),
# lecture accordée site par site. Laisser SP_SITES vide pour désactiver.
SP_CLIENT_ID=<ID-APPLICATION-SHAREPOINT>
SP_CERT_THUMBPRINT=<EMPREINTE-CERTIFICAT-SHAREPOINT>
SP_KEY_PATH=/etc/rag-certs/rag-sharepoint.key
# URL complètes, séparées par des virgules
SP_SITES=
# Bibliothèque de conservation : anciennes versions et documents supprimés
SP_EXCLUDE_DRIVES=Preservation Hold Library
SP_MAX_FILE_MB=50
SYNC_TIMEOUT_SHAREPOINT=900

# ─────────────────────────────────────────
# Fenêtres de contexte demandées à Ollama
# ─────────────────────────────────────────
# Valeurs numériques sans espace ni séparateur de milliers.
# La fenêtre du juge doit être au moins celle du modèle principal (§10.6).
# Ne pas définir OLLAMA_CONTEXT_LENGTH sur le serveur Ollama : ce réglage
# s'applique à tous les modèles, y compris le juge.
# Avec vLLM, la fenêtre est fixée au lancement du serveur (--max-model-len) :
# ces deux lignes n'ont alors plus d'effet.
LLM_NUM_CTX=16384
JUDGE_NUM_CTX=16384

# ---------------------------------------------------------
# Documents protégés par Purview (§14), inactif par défaut.
# Activation : COMPOSE_PROFILES=purview et MIP_URL=http://mip-service:8080
# MIP_TOKEN : openssl rand -hex 32
# MIP_ETIQUETTES_EXCLUES : identifiants d'étiquettes jamais déchiffrées,
#   séparés par des virgules (en production : au moins les étiquettes RH)
# ---------------------------------------------------------
COMPOSE_PROFILES=
MIP_URL=
MIP_TOKEN=changeme-mip-token
MIP_TENANT_DOMAINE=<votre-tenant>.onmicrosoft.com
MIP_CLIENT_ID=
MIP_ETIQUETTES_EXCLUES=
MIP_CACHE_TTL=3600

# ---------------------------------------------------------
# Synchronisation du corpus (pipeline n8n, §7)
# Le compte svc-rag sert à la fois au bind LDAP et au montage SMB.
# Une rotation du mot de passe impacte donc les deux : suivre la
# procédure en sept étapes documentée en §9.5.1 (rappel mensuel
# envoyé par le workflow n8n de §7.3).
# ---------------------------------------------------------
SYNC_SCRIPTS_DIR=/rag-pipeline
SYNC_PYTHON=python3
SYNC_TIMEOUT_INDEXER=600
SYNC_TIMEOUT_ACL=300
SMB_SHARE=//<NOM-FILESERVER>/PartageDocuments
SMB_MOUNT=/mnt/corpus-root
SMB_USER=svc-rag
SMB_PASSWORD=<mot-de-passe-svc-rag>
SMB_DOMAIN=VOTRE-DOMAINE

# ---------------------------------------------------------
# Indexation (paramètres transmis à indexer.py par /admin/sync)
# ---------------------------------------------------------
CHUNK_SIZE=150
CHUNK_OVERLAP=20
# Seuil minimal de mots par chunk (les chunks plus courts sont ignorés)
MIN_CHUNK_WORDS=8

# ---------------------------------------------------------
# Variables lues par indexer.py et acl_resolver.py
# Quand les scripts sont lancés par /admin/sync, main.py les dérive
# automatiquement de EMBED_BASE_URL, QDRANT_HOST et ORG_NAME.
# Ces trois lignes ne servent qu'aux lancements MANUELS depuis la VM :
#   cd /root/rag-pipeline && source .venv/bin/activate
#   set -a && source /root/rag-stack/.env && set +a
#   python indexer.py --corpus /mnt/corpus-root
# Sans elles, un lancement manuel étiquetterait les documents internes
# avec "Organisation interne" au lieu du nom réel de l'organisation.
# OLLAMA_URL désigne le serveur d'EMBEDDING, avec Ollama comme avec vLLM :
# même valeur que EMBED_BASE_URL (port 8001 avec vLLM). EMBED_API et
# VLLM_API_KEY sont lus dans le bloc du serveur de modèles, plus haut.
# ---------------------------------------------------------
OLLAMA_URL=http://<IP-SERVEUR-MODELES>:11434
QDRANT_URL=http://localhost:6333
ORG_OWNER=<Nom organisation>

# ---------------------------------------------------------
# n8n
# ---------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# ---------------------------------------------------------
# Open WebUI
# Générer la clé : openssl rand -hex 32
# ---------------------------------------------------------
WEBUI_SECRET_KEY=changeme-webui-secret-key-fort
# Durée de validité de la session utilisateur
JWT_EXPIRES_IN=4h

# ── GPU et mesures (§10) ───────────────────────────────────────────────
# Placement : vide = Ollama place le modèle sur la carte s'il y a la place ;
# 0 = CPU. Validé en lab : les trois modèles sur une carte de 16 Go.
# JUDGE_NUM_GPU=
# EMBED_NUM_GPU=
# Graine de génération : vide en usage normal, fixée pour les campagnes de mesure.
# LLM_SEED=
# Règles de prompt complémentaires (fausses absences, crochets, recopie).
# PROMPT_REGLES_V2=1
# Fenêtre d'extraits consécutifs pour les documents complémentaires.
# COMPLEMENT_VOISINS=1
# Reranker optionnel (§10.8) : vide = désactivé.
# RERANKER_URL=
# RERANK_CANDIDATS=20
# RERANK_MODE=fusion
# Durée de maintien du modèle de synthèse Teams s'il est distinct du modèle principal.
# SUMMARY_KEEP_ALIVE=2m
