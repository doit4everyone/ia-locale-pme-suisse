<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <!-- Paquet Linux du SDK MIP : le paquet générique ne contient pas les bibliothèques natives Linux -->
    <PackageReference Include="Microsoft.InformationProtection.File.Ubuntu2404" Version="1.18.148" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.*" />
  </ItemGroup>
</Project>
